<Window x:Class="Seam.ClothingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Seam"
        Title="Clothing Studio · Seam" Style="{StaticResource {x:Type Window}}" Width="1440" Height="900" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped">
  <Window.Resources>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource AccentWash}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#14171D"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Margin" Value="0,5,0,14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#14171D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,3" Foreground="{StaticResource Muted}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,30,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,15,0,6"/></Style>
  </Window.Resources>
  <Grid Background="{StaticResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="‹  Seam" Style="{StaticResource Quiet}" Click="GoHome" Margin="0,0,14,0"/><Rectangle Width="1" Height="26" Fill="{StaticResource Line}" Margin="0,0,22,0"/><StackPanel><TextBlock Text="Clothing Studio" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="A wardrobe of your own." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open project" Style="{StaticResource Quiet}" Click="OpenProjectClicked"/><Button Content="Save project" Style="{StaticResource Quiet}" Click="SaveProjectClicked" Margin="2,0,12,0"/><ComboBox x:Name="BuildTargetBox" Width="118" SelectedIndex="0" Margin="0,0,10,0" ToolTip="Pack build target"><ComboBoxItem Content="FiveM"/><ComboBoxItem Content="Singleplayer"/></ComboBox><Button x:Name="ExportButton" Content="Build pack  ↗" Style="{StaticResource Primary}" Click="ExportClicked"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="ProjectNameBox" Text="My clothing pack" VerticalAlignment="Center" TextChanged="ProjectNameChanged"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="WardrobeTab" Content="Wardrobe" Style="{StaticResource Small}" Click="WardrobeClicked"/><Button x:Name="TextureTab" Content="Texture studio" Style="{StaticResource Quiet}" Click="TextureClicked" Margin="6,0"/><Button x:Name="TattooTab" Content="Tattoo studio" Style="{StaticResource Quiet}" Click="TattooClicked"/></StackPanel>
      <Button Grid.Column="2" Content="Game folder…" Style="{StaticResource Quiet}" Click="ChooseGameFolder" ToolTip="Choose your installed GTA V folder for the real freemode character."/>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="LibraryTitle" Text="YOUR WARDROBE" Style="{StaticResource Caption}"/><TextBlock x:Name="LibraryHint" Text="Drop YDD, YDR and YTD files here." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,16" TextWrapping="Wrap"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ImportButton" Content="＋ Import files" Style="{StaticResource Small}" Click="ImportFilesClicked" Margin="0,0,5,0"/><Button x:Name="FolderButton" Grid.Column="1" Content="Add folder" Style="{StaticResource Small}" Click="ImportFolderClicked" Margin="5,0,0,0"/></Grid>
          <ListBox x:Name="ItemList" Grid.Row="2" SelectionChanged="ItemSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox x:Name="TextureList" Grid.Row="2" Visibility="Collapsed" SelectionChanged="TextureSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Width}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text=" × " Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Height}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox x:Name="TattooList" Grid.Row="2" Visibility="Collapsed" SelectionChanged="TattooSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Zone}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="LibraryCount" Text="No pieces yet" FontSize="11" Foreground="{StaticResource Muted}"/><Button x:Name="RemoveButton" Content="Remove selected" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-12,8,0,0" Click="RemoveClicked"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Background="#13161C"><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="18,0"><DockPanel VerticalAlignment="Center"><Button Content="Frame" DockPanel.Dock="Right" Style="{StaticResource Small}" Click="FrameClicked"/><TextBlock x:Name="SceneCaption" Text="FREEMODE PREVIEW" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel></Border>
        <Grid Grid.Row="1" x:Name="StudioScene"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <local:ArtworkSurface x:Name="Artwork" Visibility="Collapsed"/>
          <Grid Grid.Column="1"><local:ClothingViewport x:Name="Preview"/><Border x:Name="WelcomePanel" Background="#E913161C" VerticalAlignment="Center" Margin="36" Padding="28" CornerRadius="12" IsHitTestVisible="False"><StackPanel><TextBlock Text="Make it yours." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Import your clothing files, create textures and build a pack ready for FiveM." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="23"/><TextBlock x:Name="GameHint" Text="Select a GTA V game folder to load the real freemode character." TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,22,0,0"/></StackPanel></Border></Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="SceneHelp" Text="Drag to orbit  ·  Right-drag to pan  ·  Scroll to zoom" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
      </Grid>
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <StackPanel x:Name="WardrobeProperties"><TextBlock Text="PIECE DETAILS" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectedName" Text="Select a piece" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,4"/><TextBlock x:Name="SelectedPath" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
          <TextBlock Text="Character" Style="{StaticResource Field}"/><ComboBox x:Name="PedBox" SelectedIndex="0" SelectionChanged="AssignmentChanged"><ComboBoxItem Content="Male freemode"/><ComboBoxItem Content="Female freemode"/></ComboBox>
          <TextBlock Text="Clothing slot" Style="{StaticResource Caption}"/><ComboBox x:Name="ComponentBox" SelectedIndex="11" SelectionChanged="AssignmentChanged"><ComboBoxItem Content="0 · Head"/><ComboBoxItem Content="1 · Mask"/><ComboBoxItem Content="2 · Hair"/><ComboBoxItem Content="3 · Arms / torso"/><ComboBoxItem Content="4 · Legs"/><ComboBoxItem Content="5 · Bag"/><ComboBoxItem Content="6 · Shoes"/><ComboBoxItem Content="7 · Accessories"/><ComboBoxItem Content="8 · Undershirt"/><ComboBoxItem Content="9 · Armour"/><ComboBoxItem Content="10 · Decal"/><ComboBoxItem Content="11 · Top"/></ComboBox>
          <CheckBox x:Name="PropBox" Content="This piece is a prop" Checked="AssignmentChanged" Unchecked="AssignmentChanged"/><TextBlock Text="Drawable index" Style="{StaticResource Field}"/><TextBox x:Name="DrawableBox" Text="0" LostFocus="AssignmentChanged"/>
          <Button Content="Edit its textures" Click="EditItemTextures" Margin="0,20,0,0"/><TextBlock Text="Original files stay untouched. Edited textures and pack builds are written to separate files." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" LineHeight="19" Margin="0,20,0,0"/>
        </StackPanel>
        <StackPanel x:Name="EditorProperties" Visibility="Collapsed">
          <TextBlock x:Name="EditorTitle" Text="TEXTURE TOOLS" Style="{StaticResource Caption}"/><TextBlock x:Name="EditingName" Text="Open a YTD to begin" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,8"/>
          <StackPanel x:Name="TextureActions"><Button Content="Replace from image…" Click="ReplaceTextureClicked" Margin="0,4"/><Button Content="Export PNG / DDS…" Click="ExportTextureClicked" Margin="0,4"/><Button Content="Watch external PNG…" Click="WatchTextureClicked" Margin="0,4" ToolTip="Choose an image to watch. Saving it in another editor updates the texture and 3D preview."/><Button Content="Save YTD copy…" Style="{StaticResource Primary}" Click="SaveYtdClicked" Margin="0,12,0,0"/></StackPanel>
          <StackPanel x:Name="TattooActions" Visibility="Collapsed"><TextBox x:Name="TattooNameBox" Text="New tattoo" TextChanged="TattooMetadataChanged"/><TextBlock Text="Body zone" Style="{StaticResource Field}"/><ComboBox x:Name="ZoneBox" SelectedIndex="0" SelectionChanged="TattooMetadataChanged"><ComboBoxItem Content="Torso" Tag="ZONE_TORSO"/><ComboBoxItem Content="Head" Tag="ZONE_HEAD"/><ComboBoxItem Content="Left arm" Tag="ZONE_LEFT_ARM"/><ComboBoxItem Content="Right arm" Tag="ZONE_RIGHT_ARM"/><ComboBoxItem Content="Left leg" Tag="ZONE_LEFT_LEG"/><ComboBoxItem Content="Right leg" Tag="ZONE_RIGHT_LEG"/></ComboBox><ComboBox x:Name="TattooPedBox" SelectedIndex="0" SelectionChanged="TattooMetadataChanged"><ComboBoxItem Content="Male freemode"/><ComboBoxItem Content="Female freemode"/></ComboBox>
            <TextBlock Text="Horizontal / vertical position" Style="{StaticResource Caption}"/><Slider x:Name="TattooU" Minimum="0" Maximum="1" Value="0.5" ValueChanged="TattooPlacementChanged"/><Slider x:Name="TattooV" Minimum="0" Maximum="1" Value="0.5" ValueChanged="TattooPlacementChanged"/><TextBlock Text="Tattoo width / height" Style="{StaticResource Field}"/><Slider x:Name="TattooWidth" Minimum="0.01" Maximum="1" Value="0.2" ValueChanged="TattooPlacementChanged"/><Slider x:Name="TattooHeight" Minimum="0.01" Maximum="1" Value="0.2" ValueChanged="TattooPlacementChanged"/><TextBlock Text="Rotation" Style="{StaticResource Field}"/><Slider x:Name="TattooRotation" Minimum="-180" Maximum="180" ValueChanged="TattooPlacementChanged"/><Button Content="Save tattoo artwork" Style="{StaticResource Primary}" Click="SaveTattooClicked" Margin="0,15,0,0"/><TextBlock Text="Placement is an approximate UV preview. Check the final decoration on your server." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,22"/>
          <TextBlock Text="ARTWORK" Style="{StaticResource Caption}"/><ComboBox x:Name="PaintMode" SelectedIndex="0" SelectionChanged="PaintModeChanged"><ComboBoxItem Content="Select / move layers"/><ComboBoxItem Content="Draw"/><ComboBoxItem Content="Erase stroke"/></ComboBox>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBox x:Name="ColorBox" Text="#FFFFFF" LostFocus="BrushChanged"/><TextBox Grid.Column="1" x:Name="BrushSizeBox" Text="12" Margin="6,0,0,0" LostFocus="BrushChanged"/></Grid>
          <Button Content="Add image layer…" Click="AddImageLayerClicked" Margin="0,10,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBox x:Name="LayerTextBox" Text="SEAM"/><Button Grid.Column="1" Content="Text" Style="{StaticResource Small}" Margin="6,0,0,0" Click="AddTextLayerClicked"/></Grid>
          <ListBox x:Name="LayerList" Margin="0,12,0,0" MaxHeight="140" SelectionChanged="LayerSelected"/>
          <TextBlock Text="Layer size" Style="{StaticResource Field}"/><Slider x:Name="LayerSize" Minimum="8" Maximum="1600" Value="256" ValueChanged="LayerChanged"/><TextBlock Text="Opacity" Style="{StaticResource Field}"/><Slider x:Name="LayerOpacity" Minimum="0" Maximum="1" Value="1" ValueChanged="LayerChanged"/><TextBlock Text="Layer rotation" Style="{StaticResource Field}"/><Slider x:Name="LayerRotation" Minimum="-180" Maximum="180" ValueChanged="LayerChanged"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Undo stroke" Style="{StaticResource Small}" Click="UndoClicked"/><Button Content="Delete layer" Style="{StaticResource Small}" Click="DeleteLayerClicked" Margin="7,0,0,0"/></StackPanel>
          <Button x:Name="ApplyTextureButton" Content="Apply artwork to texture" Style="{StaticResource Primary}" Click="ApplyArtworkClicked" Margin="0,18,0,0"/>
        </StackPanel>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="3" Background="#101217" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Width="60" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/><TextBlock x:Name="StatusText" Grid.Column="1" Text="Local workspace · Your source files are preserved" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="CLOTHING STUDIO" Foreground="{StaticResource Subtle}" FontSize="9" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
  </Grid>
</Window>
