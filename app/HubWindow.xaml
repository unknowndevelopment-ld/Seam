<Window x:Class="Seam.HubWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seam — Creator tools" Style="{StaticResource {x:Type Window}}" Width="1040" Height="690" MinWidth="840" MinHeight="570" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Margin="36,26,36,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource SeamIcon}" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock Text="seam" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="1" Height="19" Background="{StaticResource Line}" Margin="22,0"/><TextBlock Text="CREATOR TOOLS" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
      <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="GTA V · LOCAL WORKSPACE" FontSize="10" Foreground="{StaticResource Subtle}"/></Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,37,0,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,23"><TextBlock Text="Choose your workspace" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Two tools. One place to build." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="27">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Height="82" HorizontalAlignment="Left" Width="132" Margin="0,0,0,22">
              <Path Data="M2,48 L58,18 L117,48 L61,79 Z" Fill="#1C2943" Stroke="#42649C" StrokeThickness="1"/>
              <Path Data="M2,30 L58,0 L117,30 L61,61 Z" Fill="#233657" Stroke="#7299E1" StrokeThickness="1"/>
              <Path Data="M58,0 L58,23 L71,30 L71,49 L61,61 M2,30 L2,48 M117,30 L117,48 M61,61 L61,79" Stroke="#9EB8FF" StrokeThickness="1.5"/>
            </Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="Map Merger" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Bring your map resources together." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,14"/><TextBlock Text="Merge YMAPs and collision patches. Repair verified placement and lighting faults, with each resource kept separate." Foreground="{StaticResource Subtle}" FontSize="12" LineHeight="21" TextWrapping="Wrap"/></StackPanel>
            <Button Grid.Row="2" x:Name="MapMergerButton" Content="Open Map Merger  →" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="20,11" Margin="0,20,0,0" Click="Map_Click"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="27">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Height="82" HorizontalAlignment="Left" Width="132" Margin="0,0,0,22">
              <Path Data="M37,5 L16,17 L2,45 L23,56 L33,40 L33,79 L91,79 L91,40 L101,56 L122,45 L108,17 L87,5 Q62,27 37,5 Z" Fill="#352E3E" Stroke="#AF92C0" StrokeThickness="1.3" StrokeLineJoin="Round"/>
              <Path Data="M37,5 Q62,45 87,5 M33,40 L29,22 M91,40 L95,22" Stroke="#D3B5E5" StrokeThickness="1.3"/>
              <Path Data="M51,49 L62,43 L73,49 L73,63 L62,69 L51,63 Z" Fill="#A889BF"/>
            </Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="Clothing Studio" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Make a pack. Make it your own." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,14"/><TextBlock Text="Organize clothing, preview the freemode ped, edit textures live, and create tattoo artwork in one workspace." Foreground="{StaticResource Subtle}" FontSize="12" LineHeight="21" TextWrapping="Wrap"/></StackPanel>
            <Button Grid.Row="2" x:Name="ClothingStudioButton" Content="Open Clothing Studio  →" HorizontalAlignment="Left" Padding="20,11" Margin="0,20,0,0" Click="Clothing_Click"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Files stay on your PC · no account required" FontSize="11" Foreground="{StaticResource Subtle}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="GTA installation" Style="{StaticResource Quiet}" Click="GameInstallation_Click" Margin="0,0,16,0"/><TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/></StackPanel></Grid>
  </Grid>
</Window>
