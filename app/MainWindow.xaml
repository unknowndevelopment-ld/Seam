<Window x:Class="Seam.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Seam" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Seam — GTA V Map Merger" Background="{StaticResource Background}" Foreground="{StaticResource Text}" Icon="{StaticResource SeamIcon}" FontFamily="Segoe UI" FontSize="13" Width="1480" Height="920" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" KeyDown="Window_KeyDown" UseLayoutRounding="True" StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BA414F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Small}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
  </Window.Resources>
  <Grid x:Name="WindowLayout" Background="{StaticResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="20,0,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource SeamIcon}" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="seam" FontSize="22" FontWeight="SemiBold" Margin="0,-3,18,0"/>
          <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="0,0,18,0"/><TextBlock Text="GTA V MAP MERGER" FontSize="10" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="ProjectControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="Tools" Style="{StaticResource Quiet}" Click="Tools_Click" Padding="11,7" MinHeight="30" ToolTip="Return to the workspace launcher"/>
          <Button Content="Open project" Style="{StaticResource Quiet}" Click="OpenProject_Click" ToolTip="Open a saved workspace (Ctrl+O)" Padding="11,7" MinHeight="30"/><Button Content="Save project" Style="{StaticResource Quiet}" Click="SaveProject_Click" ToolTip="Save source paths and priority (Ctrl+S)" Padding="11,7" MinHeight="30"/>
          <Border Width="1" Height="14" Background="{StaticResource Line}" Margin="10,0"/><Button Content="Guide" Style="{StaticResource Quiet}" Click="Help_Click" Padding="11,7" MinHeight="30"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
          <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="ActionBar" Margin="20,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="AddFolder_Click" ToolTip="Add a GTA V resource folder" AutomationProperties.Name="Add map folder"><StackPanel Orientation="Horizontal"><Path Data="M1,4 L8,4 L10,7 L21,7 L21,18 L1,18 Z" Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Add map folder"/></StackPanel></Button>
        <Button Content="Add files" Style="{StaticResource Quiet}" Margin="5,0,0,0" Click="AddFiles_Click"/>
      </StackPanel>
      <StackPanel Grid.Column="1" x:Name="WorkspaceStats" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel MinWidth="68"><TextBlock x:Name="MapCount" Text="0" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Sources" FontSize="10" Foreground="{StaticResource Subtle}" Margin="0,3,0,0"/></StackPanel>
        <Border Background="{StaticResource Line}" Width="1" Height="25" Margin="12,0,22,0"/>
        <StackPanel MinWidth="68"><TextBlock x:Name="EntityCount" Text="0" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Placements" FontSize="10" Foreground="{StaticResource Subtle}" Margin="0,3,0,0"/></StackPanel>
        <Border Background="{StaticResource Line}" Width="1" Height="25" Margin="12,0,22,0"/>
        <StackPanel MinWidth="68"><TextBlock x:Name="OutputCount" Text="0" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Outputs" FontSize="10" Foreground="{StaticResource Subtle}" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="AutoMergeButton" Content="Auto merge" Style="{StaticResource Primary}" IsEnabled="False" Click="AutoMerge_Click" Padding="21,10"/>
        <Button x:Name="ExportButton" Content="Export resources  ↗" IsEnabled="False" Click="Export_Click" Margin="8,0,0,0" Padding="17,10"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" x:Name="WorkspaceGrid" Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
        <Grid><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="17,17,17,0"><TextBlock Text="Source maps" Style="{StaticResource SectionTitle}"/><TextBlock Text="Top source takes priority." Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="10,0">
            <ListBox x:Name="PackList" SelectionChanged="PackList_SelectionChanged" AutomationProperties.Name="Source maps"><ListBox.ItemTemplate><DataTemplate>
              <Grid Margin="11,13"><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{Binding Color}" CornerRadius="1"/>
                <StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock Text="{Binding Root}" FontSize="10" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Root}"/></StackPanel>
                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled,Mode=TwoWay}" Click="PackEnabled_Click" VerticalAlignment="Top" Margin="0,1,-8,0" ToolTip="Include this source" AutomationProperties.Name="{Binding Name}"/>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel x:Name="SourcesEmpty" Margin="13,24,13,0" VerticalAlignment="Top"><Path Data="M1,4 L8,4 L10,7 L21,7 L21,18 L1,18 Z" Width="28" Height="24" Stretch="Uniform" Stroke="#5E6F8E" StrokeThickness="1.1" StrokeLineJoin="Round" HorizontalAlignment="Left" Margin="0,0,0,15"/><TextBlock Text="No sources added" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="Add folders or drop them into the viewport." FontSize="11" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0"/></StackPanel>
          </Grid>
          <Border Grid.Row="2" BorderBrush="#292E38" BorderThickness="0,1,0,0" Padding="12,11">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem,ElementName=PackList}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Content="&#xE74A;" Style="{StaticResource IconButton}" Click="MoveUp_Click" ToolTip="Higher priority" AutomationProperties.Name="Move source up"/><Button Grid.Column="1" Content="&#xE74B;" Margin="5,0,0,0" Style="{StaticResource IconButton}" Click="MoveDown_Click" ToolTip="Lower priority" AutomationProperties.Name="Move source down"/><Button Grid.Column="2" Content="Remove" HorizontalAlignment="Right" Style="{StaticResource Quiet}" Padding="10,5" MinHeight="30" Click="RemovePack_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="3" Background="#161920" CornerRadius="0,0,9,9" Padding="16,15">
            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Your originals stay intact" FontSize="11" FontWeight="Medium"/></StackPanel><TextBlock Text="Each source exports to its own _merged folder, with escrow files preserved." TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="11" LineHeight="18" Margin="0,8,0,0"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Background="#13161C" ClipToBounds="True">
        <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="15,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Viewport" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="SceneSummary" Text="0 objects" Foreground="{StaticResource Subtle}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="CollisionToggle" Content="Collision" FontSize="11" IsChecked="True" Click="CollisionToggle_Click" Margin="0,0,14,0"/><Button x:Name="FrameAllButton" Content="Frame all" Style="{StaticResource Small}" Click="FrameAll_Click" ToolTip="Frame all enabled geometry (Home)"/></StackPanel>
            </Grid>
          </Border>
          <local:MapViewport Grid.Row="1" x:Name="Viewport" ItemSelected="Viewport_ItemSelected"/>
          <Border Grid.Row="1" x:Name="PreviewDisabled" Background="{StaticResource Background}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Margin="30"><TextBlock Text="3D preview disabled" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Choose a GTA V installation to enable 3D previews. Map merging and fixing work without it." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,15,0,20"/><Button Content="GTA installation" Click="GameInstallation_Click" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Border>
          <Grid Grid.Row="1" x:Name="Welcome">
            <Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#13161C" Geometry="M0,0 H40 V40 H0 Z"/><GeometryDrawing Geometry="M40,0 L0,0 L0,40"><GeometryDrawing.Pen><Pen Brush="#1B202A" Thickness="0.7"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="26,0,26,32">
              <Viewbox Width="220" Height="145" Margin="0,0,0,16" IsHitTestVisible="False"><Canvas Width="240" Height="150">
                <Path Data="M20,91 L118,39 L221,92 L123,146 Z" Fill="#171F2F" Stroke="#314468" StrokeThickness="1"/><Path Data="M20,68 L118,16 L221,69 L123,123 Z" Fill="#1D2940" Stroke="#587CB7" StrokeThickness="1"/><Path Data="M20,68 L20,91 M123,123 L123,146 M221,69 L221,92" Stroke="#314468" StrokeThickness="1"/>
                <Path Data="M47,68 L119,30 L194,69 L122,108 Z M82,49 L157,88 M62,80 L133,42 M102,101 L174,62" Stroke="#3F567A" StrokeThickness="0.8"/><Path Data="M118,16 L119,52 L139,62 L139,92 L123,123" Stroke="#9EB8FF" StrokeThickness="2" StrokeLineJoin="Round"/>
                <Path Data="M73,74 L91,64 L108,73 L90,83 Z M145,49 L162,40 L180,49 L162,59 Z" Fill="#304D7B" Stroke="#658BC6" StrokeThickness="0.8"/><Ellipse Canvas.Left="112" Canvas.Top="46" Width="12" Height="12" Fill="#9EB8FF"/><Ellipse Canvas.Left="116" Canvas.Top="50" Width="4" Height="4" Fill="#182139"/>
              </Canvas></Viewbox>
              <TextBlock Text="Start with your maps." FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="Add your resource folders, set their priority,&#x0a;and bring them together." TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,12,0,22"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Add map folder" Style="{StaticResource Primary}" Click="AddFolder_Click" Padding="18,10"/><Button Content="Try the demo" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="Demo_Click"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,23,0,0"><TextBlock Text="YMAP + YBN" FontSize="10" Foreground="{StaticResource Subtle}"/><Ellipse Fill="#4E5D74" Width="3" Height="3" Margin="10,0"/><TextBlock Text="Escrow files preserved" FontSize="10" Foreground="{StaticResource Subtle}"/></StackPanel>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" x:Name="SelectionCard" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#F21D2431" BorderBrush="#465B80" BorderThickness="1" CornerRadius="7" Margin="15,0,15,50" Padding="14" MaxWidth="480">
            <StackPanel><TextBlock x:Name="SelectedLabel" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,12"/><Button x:Name="FrameSelectionButton" Content="Frame selection" Style="{StaticResource Small}" Click="FrameSelection_Click" HorizontalAlignment="Left"/></StackPanel>
          </Border>
          <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#ED151920" BorderBrush="#272F3B" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="12,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Orbit · drag    Pan · right-drag    Zoom · scroll" FontSize="10" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="SOURCE PREVIEW" FontSize="9" Foreground="#687791" Margin="12,0,0,0"/></Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="15,17,15,14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Merge activity" Style="{StaticResource SectionTitle}"/><Border Grid.Column="1" Background="#232936" CornerRadius="4" Padding="6,3"><TextBlock x:Name="ActivityBadge" Text="IDLE" FontSize="9" Foreground="{StaticResource Muted}"/></Border></Grid>
          <Border Grid.Row="1" Background="#1D2535" BorderBrush="#344462" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,17,0,14">
            <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="MergeState" Text="Add your maps" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="MergeSummary" Text="Add source folders to get started." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="18" Margin="0,8,0,0"/></StackPanel>
          </Border>
          <Grid Grid.Row="2" Margin="0,0,0,13">
            <TextBox x:Name="Search" Padding="32,9,10,9" FontSize="11" ToolTip="Search merge activity" TextChanged="Search_TextChanged" AutomationProperties.Name="Search merge activity"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Subtle}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Text="Search activity" FontSize="11" Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
          <Grid Grid.Row="3">
            <ListBox x:Name="ResultList" SelectionChanged="ResultList_SelectionChanged" AutomationProperties.Name="Merge activity"><ListBox.ItemTemplate><DataTemplate>
              <StackPanel Margin="12,12"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
            </DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel x:Name="NoResults" VerticalAlignment="Center" Margin="16,0,16,30">
              <Border Width="38" Height="38" Background="#232936" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,15"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#7183A3" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
              <TextBlock x:Name="NoResultsTitle" Text="Nothing here yet" FontSize="13" FontWeight="Medium" TextAlignment="Center"/><TextBlock x:Name="NoResultsDetail" Text="Merge progress and file details will appear here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" LineHeight="19" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="4" x:Name="ResultDetailCard" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,10,0,0"><ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultDetail" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="19"/></ScrollViewer></Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#252A34" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#83B9A0" Margin="0,0,8,0"/><TextBlock Grid.Column="1" x:Name="StatusText" Text="All files stay on your PC" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></Grid>
        <Button Grid.Column="1" x:Name="NoticeButton" Content="" Visibility="Collapsed" Click="Notices_Click" Style="{StaticResource Quiet}" Padding="8,3" MinHeight="24" FontSize="10"/><TextBlock Grid.Column="2" Text="LOCAL WORKSPACE" Foreground="{StaticResource Subtle}" FontSize="9" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
    </Border>
    <Border x:Name="BusyOverlay" Grid.Row="2" Visibility="Collapsed" Background="#DA111318" CornerRadius="9" Margin="16,0,16,12">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="30"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="32">
        <StackPanel><TextBlock Text="Working on your maps" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="BusyText" Text="Reading assets…" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,22"/><ProgressBar IsIndeterminate="True" Width="260" Height="3" Foreground="{StaticResource AccentFill}" Background="#303A4B" BorderThickness="0"/><TextBlock Text="Source files stay intact." Foreground="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,17,0,0" FontSize="11"/></StackPanel>
      </Border></StackPanel>
    </Border>
  </Grid>
</Window>
