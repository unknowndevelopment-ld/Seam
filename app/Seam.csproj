<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Seam</AssemblyName>
    <RootNamespace>Seam</RootNamespace>
    <Version>2.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Seam.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CodeWalker.Core"><HintPath>../lib/CodeWalker.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX"><HintPath>../lib/SharpDX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.Mathematics"><HintPath>../lib/SharpDX.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <EmbeddedDependency Include="../lib/*.dll" />
    <EmbeddedResource Include="@(EmbeddedDependency -> '$(IntermediateOutputPath)embedded/%(Filename)%(Extension).gz')" LogicalName="Seam.Dependencies.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../lib/Notice.txt" LogicalName="Seam.CodeWalker-Notice.txt" />
    <EmbeddedResource Include="../THIRD-PARTY.md" LogicalName="Seam.ThirdParty.txt" />
  </ItemGroup>
  <Target Name="CompressEmbeddedDependencies" BeforeTargets="AssignTargetPaths" Inputs="@(EmbeddedDependency);../build/Compress-Dependencies.ps1" Outputs="@(EmbeddedDependency -> '$(IntermediateOutputPath)embedded/%(Filename)%(Extension).gz')">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\Compress-Dependencies.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)embedded&quot;" />
  </Target>
</Project>
